#!/usr/bin/env zsh

set -euo pipefail

export TF_VAR_os_name=$(ansible-inventory --inventory inventory.yml --host all | jq --raw-output '.os_name')
export TF_VAR_os_version=$(ansible-inventory --inventory inventory.yml --host all | jq --raw-output '.os_version')

terraform apply
scripts/wait-for-it

serverName=$(terraform show -json | jq --raw-output '.values.root_module.resources[] | select (.type == "hcloud_server").values.name')
echo "$serverName $(terraform output -raw ssh_host_key_public)" >> ~/.ssh/known_hosts

ansible-playbook --inventory inventory.yml playbook.yml
