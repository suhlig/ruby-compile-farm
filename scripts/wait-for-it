#!/usr/bin/env zsh

set -euo pipefail

for tool in hcloud jq retry tailscale terraform; do
  if ! command -v $tool &> /dev/null; then
    echo "required tool $tool missing"
    exit 1
  fi
done

serverName=$(terraform show -json | jq --raw-output '.values.root_module.resources[] | select (.type == "hcloud_server").values.name')

retry --until=success --delay "1,2,4,8,16,32,64" -- hcloud server list --output json | jq --raw-output --exit-status --arg serverName "$serverName" '.[] | select(.name == $serverName).status' > /dev/null
retry --until=success --delay "1,2,4,8,16,32,64" -- tailscale status --json | jq --exit-status --arg serverName "$serverName" '.Peer[] | select(.Online and .HostName == $serverName) | { HostName, Created }'
