#!/usr/bin/env zsh

set -euo pipefail

for tool in hcloud jq retry tailscale terraform; do
  if ! command -v $tool &> /dev/null; then
    echo "required tool $tool missing"
    exit 1
  fi
done

serverName=$(terraform show -json | jq --raw-output '.values.root_module.resources[] | select (.type == "hcloud_server").values.name')

retry \
  --until=success \
  --times 10 \
  --delay 30 \
  --message "Check if the server is up" \
  -- \
    zsh -c "hcloud server list --output json | jq --raw-output --exit-status --arg serverName $serverName '.[] | select(.name == \$serverName).status' > /dev/null"

retry \
  --until=success \
  --times 10 \
  --delay 30 \
  --message "Check if Tailscale network is up" \
  -- \
    zsh -c "tailscale status --json 2> /dev/null | jq --exit-status --arg serverName $serverName '.Peer[] | select(.Online and .HostName == \$serverName) | { HostName, Created }'"
